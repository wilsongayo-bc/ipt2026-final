4: Authentication Service with Signals
Instructor Cue: "The AuthService is the heart of your frontend authentication. It manages login state, stores tokens, and exposes reactive signals for the UI."
A. Create the Auth Service
src/app/core/services/auth.service.ts:
import { Injectable, inject, signal, computed } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Router } from '@angular/router';
import { Observable, tap, map } from 'rxjs';
import { environment } from '../../../environments/environment';


// Interfaces matching backend DTOs
export interface User {
   id: number;
   name: string;
   email: string;
   isActive: boolean;
   createdAt: string;
}


export interface LoginRequest {
   email: string;
   password: string;
}


export interface RegisterRequest {
   name: string;
   email: string;
   password: string;
   age?: number;
}


export interface AuthResponse {
   token: string;
   user: User;
}


export interface ApiResponse<T> {
   success: boolean;
   message?: string;
   data?: T;
   error?: {
       code: string;
       message: string;
       details?: any;
   };
}


@Injectable({
   providedIn: 'root'
})
export class AuthService {
   private http = inject(HttpClient);
   private router = inject(Router);
   private apiUrl = environment.apiUrl;


   // === SIGNALS (Reactive State) ===
  
   // Current user signal
   private currentUserSignal = signal<User | null>(this.getStoredUser());
  
   // Token signal
   private tokenSignal = signal<string | null>(this.getStoredToken());
  
   // Loading state
   private loadingSignal = signal<boolean>(false);
  
   // Error message
   private errorSignal = signal<string | null>(null);


   // === COMPUTED SIGNALS (Derived State) ===
  
   // Is user logged in?
   isLoggedIn = computed(() => !!this.tokenSignal() && !!this.currentUserSignal());
  
   // Current user (public read-only)
   currentUser = computed(() => this.currentUserSignal());
  
   // Current token (for interceptor)
   currentToken = computed(() => this.tokenSignal());
  
   // Loading state
   isLoading = computed(() => this.loadingSignal());
  
   // Error message
   error = computed(() => this.errorSignal());


   // === METHODS ===


   /**
    * Login user
    */
   login(credentials: LoginRequest): Observable<AuthResponse> {
       this.loadingSignal.set(true);
       this.errorSignal.set(null);


       return this.http.post<ApiResponse<AuthResponse>>(
           `${this.apiUrl}/auth/login`,
           credentials
       ).pipe(
           tap({
               next: (response) => {
                   if (response.success && response.data) {
                       this.handleLoginSuccess(response.data);
                   }
               },
               error: (error) => {
                   this.loadingSignal.set(false);
                   this.errorSignal.set(
                       error.error?.error?.message || 'Login failed'
                   );
               }
           }),
           map(response => {
               this.loadingSignal.set(false);
               return response.data!;
           })
       );
   }


   /**
    * Register new user
    */
   register(data: RegisterRequest): Observable<{ message: string }> {
       this.loadingSignal.set(true);
       this.errorSignal.set(null);


       return this.http.post<ApiResponse<{ message: string; userId: number }>>(
           `${this.apiUrl}/auth/register`,
           data
       ).pipe(
           tap({
               error: (error) => {
                   this.loadingSignal.set(false);
                   this.errorSignal.set(
                       error.error?.error?.message || 'Registration failed'
                   );
               }
           }),
           map(response => {
               this.loadingSignal.set(false);
               return { message: response.data?.message || 'Registration successful' };
           })
       );
   }


   /**
    * Verify email with token
    */
   verifyEmail(token: string): Observable<{ message: string }> {
       return this.http.get<ApiResponse<null>>(
           `${this.apiUrl}/auth/verify-email?token=${token}`
       ).pipe(
           map(response => ({
               message: response.message || 'Email verified successfully'
           }))
       );
   }


   /**
    * Request password reset
    */
   forgotPassword(email: string): Observable<{ message: string }> {
       return this.http.post<ApiResponse<null>>(
           `${this.apiUrl}/auth/forgot-password`,
           { email }
       ).pipe(
           map(response => ({
               message: response.message || 'Reset link sent'
           }))
       );
   }


   /**
    * Reset password with token
    */
   resetPassword(token: string, newPassword: string): Observable<{ message: string }> {
       return this.http.post<ApiResponse<null>>(
           `${this.apiUrl}/auth/reset-password`,
           { token, newPassword }
       ).pipe(
           map(response => ({
               message: response.message || 'Password reset successful'
           }))
       );
   }


   /**
    * Get current user from backend
    */
   getCurrentUser(): Observable<User> {
       return this.http.get<ApiResponse<User>>(`${this.apiUrl}/auth/me`).pipe(
           map(response => response.data!)
       );
   }


   /**
    * Logout user
    */
   logout(): void {
       // Clear signals
       this.currentUserSignal.set(null);
       this.tokenSignal.set(null);
      
       // Clear storage
       localStorage.removeItem('auth_token');
       localStorage.removeItem('current_user');
      
       // Navigate to login
       this.router.navigate(['/auth/login']);
   }


   /**
    * Clear error message
    */
   clearError(): void {
       this.errorSignal.set(null);
   }


   // === PRIVATE HELPERS ===


   private handleLoginSuccess(authData: AuthResponse): void {
       // Update signals
       this.tokenSignal.set(authData.token);
       this.currentUserSignal.set(authData.user);
      
       // Persist to storage
       localStorage.setItem('auth_token', authData.token);
       localStorage.setItem('current_user', JSON.stringify(authData.user));
   }


   private getStoredToken(): string | null {
       return localStorage.getItem('auth_token');
   }


   private getStoredUser(): User | null {
       const stored = localStorage.getItem('current_user');
       return stored ? JSON.parse(stored) : null;
   }
}
B. Why This Design?
1. Signals for State Management:
* currentUserSignal - Reactive user data
* tokenSignal - Reactive token
* loadingSignal - UI loading states
* errorSignal - Error messages
2. Computed Signals:
* isLoggedIn - Derived from token + user
* currentUser - Public read-only access
* currentToken - Used by interceptor
3. Single Source of Truth:
* All auth state in one service
* Components just read signals
* No scattered state across components
4. Type Safety:
* Interfaces match backend DTOs
* Compile-time error checking
* IDE autocomplete
Checkpoint 2: Your AuthService is complete with modern Signals-based state management.
